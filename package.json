{
  "name": "rawko-worker-flyover",
  "version": "0.1.0",
  "description": "Worker que genera videos 3D cinemáticos de rutas de Rawko via MapLibre + Puppeteer + FFmpeg",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test:single": "tsx src/cli.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@sparticuz/chromium": "^131.0.1",
    "@supabase/supabase-js": "^2.105.4",
    "dotenv": "^17.2.3",
    "puppeteer-core": "^23.11.1",
    "fluent-ffmpeg": "^2.1.3"
  },
  "devDependencies": {
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/node": "^22.10.5",
    "tsx": "^4.20.7",
    "typescript": "^5.7.3"
  }
}
